# --- Planning Center OAuth app ---
# Get these from https://api.planningcenteronline.com/oauth/applications
PCO_CLIENT_ID=your-pco-client-id-here
PCO_CLIENT_SECRET=your-pco-client-secret-here

# Must EXACTLY match a Redirect URI registered on the PCO OAuth app.
# Local dev:     http://localhost:8000/auth/callback
# Production:    https://pco-mcp.greenwoodbc.net/auth/callback
PCO_REDIRECT_URI=http://localhost:8000/auth/callback

# Scopes requested from PCO. Space-separated. Add more later as we expand modules.
PCO_SCOPES=services

# --- Server secrets ---
# Generate ONCE with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER change this after first run — it decrypts stored PCO tokens.
ENCRYPTION_KEY=changeme-generate-with-fernet

# Random 32+ byte secret used for signing OAuth state cookies.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=changeme-random-string

# --- Runtime ---
PORT=8000
LOG_LEVEL=info

# 0 = sessions never expire from inactivity (recommended).
# Any positive integer = session is deleted if last_used is older than this many days.
SESSION_EXPIRY_DAYS=0

# --- Admin page (optional) ---
# Set both to enable /admin (list connected users + revoke sessions).
# Leave blank to disable — /admin returns 503.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Cloudflare Tunnel (production deployment only) ---
# Token from Cloudflare Zero Trust dashboard -> Tunnels -> Connectors.
# Read by docker-compose to populate the cloudflared service's env.
# Not used by the FastAPI app itself.
CLOUDFLARE_TUNNEL_TOKEN=
